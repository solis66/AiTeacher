# ============================================================
# AiTeachers 阿里云部署环境变量模板
# 复制为仓库根目录的 .env 后填写真实值（.env 已被 .gitignore 排除，不会入库）
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# docker-compose.yml 通过 env_file: ./.env 注入容器。
# ============================================================

# ---- AI 模型（阿里云百炼 DashScope，必填）----
DASHSCOPE_API_KEY=sk-你的key

# ---- Supabase PostgreSQL（Session pooler）----
PG_HOST=aws-0-ap-southeast-1.pooler.supabase.com
PG_PORT=5432
PG_DB=postgres
PG_USER=postgres.ufwfyhamsiftpqqbtnma
PG_PASSWORD=你的Supabase密码

# ---- 阿里云 OCR（如用到批改图片识别）----
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=