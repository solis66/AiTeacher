{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-BACKEND-DOMAIN/api/:path*"
    },
    {
      "source": "/chat",
      "destination": "https://YOUR-BACKEND-DOMAIN/chat"
    },
    {
      "source": "/login",
      "destination": "https://YOUR-BACKEND-DOMAIN/login"
    },
    {
      "source": "/register",
      "destination": "https://YOUR-BACKEND-DOMAIN/register"
    },
    {
      "source": "/ocr",
      "destination": "https://YOUR-BACKEND-DOMAIN/ocr"
    },
    {
      "source": "/health",
      "destination": "https://YOUR-BACKEND-DOMAIN/health"
    },
    {
      "source": "/config/check",
      "destination": "https://YOUR-BACKEND-DOMAIN/config/check"
    },
    {
      "source": "/get_history",
      "destination": "https://YOUR-BACKEND-DOMAIN/get_history"
    },
    {
      "source": "/get_history/:path*",
      "destination": "https://YOUR-BACKEND-DOMAIN/get_history/:path*"
    },
    {
      "source": "/save_history",
      "destination": "https://YOUR-BACKEND-DOMAIN/save_history"
    },
    {
      "source": "/delete_history",
      "destination": "https://YOUR-BACKEND-DOMAIN/delete_history"
    }
  ]
}
